{
  "name": "pinata",
  "private": true,
  "description": "AI-driven pixel-art character animation: scripted physics, IK and secondary motion with machine-checkable diagnostics",
  "license": "MIT",
  "author": "Denis Sablic",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dsablic/pinata.git"
  },
  "keywords": [
    "pixel-art",
    "animation",
    "inverse-kinematics",
    "cloth-simulation",
    "procedural-animation",
    "ai-agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "p1": "node pocs/p1-static-style/run.ts",
    "p1:verify": "node pocs/p1-static-style/run.ts --verify",
    "p2": "node pocs/p2-pixel-stability/run.ts",
    "p2:verify": "node pocs/p2-pixel-stability/run.ts --verify",
    "p3": "node pocs/p3-secondary-motion/run.ts",
    "p3:verify": "node pocs/p3-secondary-motion/run.ts --verify",
    "p4": "node pocs/p4-locomotion/run.ts",
    "p4:verify": "node pocs/p4-locomotion/run.ts --verify",
    "p6": "node pocs/p6-style-swap/run.ts",
    "p6:verify": "node pocs/p6-style-swap/run.ts --verify",
    "skins": "node pocs/skins-spike/run.ts",
    "demo": "node pocs/demo-pinata/run.ts",
    "check": "node src/cli/check.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
