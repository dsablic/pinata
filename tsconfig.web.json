{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [],
    "strict": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist/web",
    "rootDir": "src"
  },
  "files": [
    "src/runtime/browser.ts",
    "src/runtime/showcase.ts",
    "src/world/page.ts",
    "src/page/page.ts"
  ]
}
